    {
      "name": "Private/public selector",
      "kind": "input",
      "description": "Native radio controls with an underline and a focus outline on the associated label.",
      "html": "<div class=\"ds-stage\"><fieldset class=\"ds-selector\"><legend class=\"ds-hidden\">Choose pricing example</legend><input class=\"ds-hidden\" type=\"radio\" name=\"ds-pricing\" id=\"ds-private\" checked><input class=\"ds-hidden\" type=\"radio\" name=\"ds-pricing\" id=\"ds-public\"><div class=\"ds-options\"><label for=\"ds-private\">Private pricing</label><label for=\"ds-public\">Public pricing</label></div></fieldset></div>",
      "css": ".ds-stage{padding:1.5rem;background:var(--warden-black,#080808);color:var(--warden-white,#f4f4f2);font-family:var(--sans,\"Manrope\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);}.ds-selector{min-inline-size:0;border:0;margin:0;padding:0}.ds-hidden{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}.ds-options{display:flex;gap:1.5rem}.ds-options label{position:relative;display:inline-flex;align-items:center;min-height:48px;color:var(--warden-muted-dark,#a3a3a3);font-size:.8125rem;cursor:pointer}.ds-options label::after{content:\"\";position:absolute;inset:auto 0 0;height:1px;background:var(--warden-white,#f4f4f2);transform:scaleX(0);transition:transform var(--warden-fast,180ms) var(--warden-ease,cubic-bezier(.16,1,.3,1))}#ds-private:checked~.ds-options label[for=\"ds-private\"],#ds-public:checked~.ds-options label[for=\"ds-public\"]{color:#fff}#ds-private:checked~.ds-options label[for=\"ds-private\"]::after,#ds-public:checked~.ds-options label[for=\"ds-public\"]::after{transform:scaleX(1)}#ds-private:focus-visible~.ds-options label[for=\"ds-private\"],#ds-public:focus-visible~.ds-options label[for=\"ds-public\"]{outline:2px solid #fff;outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-options label::after{transition:none}}",
