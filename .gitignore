# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
web/dist/
*.tsbuildinfo
# Desktop app build output
desktop/dist/
out/
# QVAC worker bundle, generated by the Electron Forge plugin at package time
qvac/

# QVAC model cache (multi-GB, downloaded on first run)
.qvac/
models/
*.gguf
*.onnx

# Runtime data — regenerated, never committed
data/audit.jsonl
data/audit-redteam.jsonl
# scripts/probe-rewrite.ts, kept out of the gateway's own chain
data/audit-probe.jsonl
# records how long each log should be, so a removed tail is detectable
data/audit.witness.json
data/audit-redteam.witness.json
data/audit-probe.witness.json
data/policies.json
# the live directory; data/seed/company.json is the committed starting point
data/company.json
# blocks employees reported as wrong. Written by them, about their own work —
# not a fixture, and not ours to commit.
data/appeals.jsonl
data/escalations.json
# administrators' answers to held prompts. The queue itself is derived from the
# audit log; only the answers live here.
data/escalations.jsonl
data/cache/

# Generated reports (REPORT.md and BENCHMARKS.md ARE committed — they are deliverables)
data/redteam-runs/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
# local machine config, generated by npm run setup
warden.local.json

# generated by npm run redteam; REPORT.md is the deliverable
data/redteam-last.json
data/redteam-last.mock.json
data/redteam-last.mock.md
# a --class run appends the class to either name
data/redteam-last.mock.*.md
# REPORT.md is the deliverable; a filtered real run writes REPORT.<class>.md
REPORT.*.md

# Mock benchmark output — never the real table.
BENCHMARKS.mock.md
.vercel
.env*
